    {
      "parameters": {
        "method": "POST",
        "url": "https://lite.duckduckgo.com/lite/",
        "sendBody": true,
        "specifyBody": "keyParameters",
        "bodyParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $node[\"Loop Through Companies\"].json[\"company_name\"] }} official website"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
            }
          ]
        },
        "responseFormat": "text",
        "options": {}
      },
      "id": "b304b22f-a23d-493c-9da1-ffb1cb9e8fb9",
      "name": "Search Google/Web",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rawBody = $json.body || $json.data || (typeof $json === 'string' ? $json : '');\nconst html = typeof rawBody === 'string' ? rawBody : JSON.stringify(rawBody || '');\n\nconst matches = [];\nconst hrefRegex = /href=[\"'](https?:\\/\\/[^\"']+)[\"']/g;\nlet match;\nwhile ((match = hrefRegex.exec(html)) !== null) {\n  let url = match[1];\n  if (url.includes('uddg=')) {\n    try {\n      const uddgMatch = url.match(/uddg=([^&]+)/);\n      if (uddgMatch) {\n        url = decodeURIComponent(uddgMatch[1]);\n      }\n    } catch (e) {}\n  }\n  matches.push(url);\n}\n\nconst blacklist = [\n  'google.', 'gstatic.', 'linkedin.', 'duckduckgo.', 'w3.org', \n  'facebook.', 'instagram.', 'twitter.', 'x.com', 'pinterest.',\n  'zaubacorp.', 'thecompanycheck.', 'companydetails.', 'falconebiz.',\n  'indiamart.', 'justdial.', 'tofler.', 'tradeindia.', 'startupindia.',\n  'startuptn.', 'mca.gov.', 'glassdoor.', 'ambitionbox.', 'crunchbase.',\n  'tracxn.', 'wikipedia.', 'indiahix.', 'lusha.', 'apollo.io',\n  'zoominfo.', 'quickr.', 'sulekha.', 'yellowpages.'\n];\n\nconst candidateWebsite = matches.find(url => {\n  const lowercaseUrl = url.toLowerCase();\n  return !blacklist.some(domain => lowercaseUrl.includes(domain));\n}) || '';\n\nconst linkedinUrl = matches.find(url => url.includes('linkedin.com/company/')) || '';\n\nreturn {\n  company_name: $node[\"Loop Through Companies\"].json[\"company_name\"],\n  candidate_website: candidateWebsite || '',\n  candidate_linkedin: linkedinUrl || ''\n};"
      },
      "id": "c104b32f-b33d-493c-8da1-ffb2cb9e8fc1",
      "name": "Find Candidate Sites",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $json[\"candidate_website\"] || 'https://example.com' }}",
        "responseFormat": "text",
        "options": {
          "includeInputFields": true
        }
      },
      "id": "d104b42f-c43d-493c-9ea1-ffb3cb9e8fd2",
      "name": "Visit Official Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const html = $json.body || '';\nconst website = $json.candidate_website || '';\nlet contactUrl = null;\n\nif (website && html) {\n  const hrefRegex = /href=[\"'](https?:\\/\\/[^\"']+)[\"']/g;\n  let match;\n  const hrefs = [];\n  while ((match = hrefRegex.exec(html)) !== null) {\n    hrefs.push(match[1]);\n  }\n  \n  const contactHref = hrefs.find(h => h.toLowerCase().includes('contact'));\n  \n  if (contactHref) {\n    try {\n      if (contactHref.startsWith('/') || !contactHref.startsWith('http')) {\n        const base = new URL(website);\n        contactUrl = new URL(contactHref, base.origin).href;\n      } else {\n        contactUrl = contactHref;\n      }\n    } catch (e) {} \n  }\n}\n\nreturn {\n  company_name: $json.company_name,\n  candidate_website: website,\n  candidate_linkedin: $json.candidate_linkedin,\n  homepage_html: html,\n  contact_page_url: contactUrl\n};"
      },
      "id": "e104b52f-d53d-493c-9fa1-ffb2cb9e8fe8",
      "name": "Extract Contact Us Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
