    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert data scraper. Read the following combined HTML sources from the official website, contact page, and LinkedIn page for the company '{{ $json.company_name }}'.\n\nExtract and return the following fields:\n1. 'website': The company's main official website URL.\n2. 'email': The official contact or support email.\n3. 'phone': The main contact phone number in clean format (e.g. +91 44 1234 5678).\n4. 'linkedin': The company's official LinkedIn page.\n\nCombined HTML Data:\n--- Homepage HTML ---\n{{ $json.homepage_html }}\n\n--- Contact Page HTML ---\n{{ $json.contact_html }}\n\n--- LinkedIn HTML ---\n{{ $json.body }}\n\nReturn the output STRICTLY as a valid JSON object matching this schema:\n{\n  \"website\": \"string or null\",\n  \"email\": \"string or null\",\n  \"phone\": \"string or null\",\n  \"linkedin\": \"string or null\"\n}",
        "options": {}
      },
      "id": "b404b52f-d53d-493c-9fa1-ffb2cb9e8fe1",
      "name": "AI Details Extractor",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1950,
        200
      ]
    },
    {
      "parameters": {
        "modelName": "gemini-1.5-flash",
        "options": {
          "temperature": 0.1
        }
      },
      "id": "c404b52f-d53d-493c-9fa1-ffb2cb9e8fe2",
      "name": "Google Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1900,
        350
      ],
      "credentials": {
        "googleIdentifyOAuth2Api": {
          "id": "new-credentials-id",
          "field": "googleIdentifyOAuth2Api"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let aiResult = {};\ntry {\n  const rawText = $node[\"AI Details Extractor\"].json.text || '';\n  // Extract JSON block if the model wraps it in markdown fence block\n  const jsonMatch = rawText.match(/\\{([\\s\\S]*)\\}/);\n  if (jsonMatch) {\n    aiResult = JSON.parse(jsonMatch[0]);\n  } else {\n    aiResult = JSON.parse(rawText);\n  }\n} catch (e) {}\n\nreturn {\n  website: aiResult.website || $json.candidate_website || null,\n  linkedin: aiResult.linkedin || $json.candidate_linkedin || null,\n  phone: aiResult.phone || null,\n  email: aiResult.email || null,\n  confidence_score: aiResult.phone ? 0.95 : 0.60,\n  enrichment_status: 'completed'\n};"
      },
      "id": "e104b52f-d53d-493c-9fa1-ffb2cb9e8fe3",
      "name": "Format AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2150,
